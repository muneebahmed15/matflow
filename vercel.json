{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "regions": ["iad1"],
  "git": {
    "deploymentEnabled": {
      "main": true,
      "master": true
    }
  },
  "crons": [
    { "path": "/api/cron/daily-digest", "schedule": "0 13 * * *" },
    { "path": "/api/cron/waiver-expiry-reminders", "schedule": "0 14 * * *" },
    { "path": "/api/cron/lead-reminders", "schedule": "0 15 * * *" },
    { "path": "/api/cron/campaigns", "schedule": "0 16 * * *" },
    { "path": "/api/cron/class-reminders", "schedule": "0 * * * *" },
    { "path": "/api/cron/win-back", "schedule": "0 17 * * *" }
  ],
  "functions": {
    "src/app/api/stripe/webhook/route.ts": {
      "maxDuration": 30
    },
    "src/app/api/**/*.ts": {
      "maxDuration": 15
    }
  }
}
