# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (required for billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App URL used for Stripe checkout redirects and Supabase auth callbacks
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (required in production for transactional email)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=MatsFlow <onboarding@yourdomain.com>

# Cron job authentication (required in production — set in Vercel env)
# CRON_SECRET=generate-a-long-random-string

# Upstash Redis (required in production for distributed rate limiting)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Dedicated secrets (recommended in production; do not reuse service role key)
# UNSUBSCRIBE_SECRET=
# CONVERSATION_TOKEN_SECRET=

# Optional: OpenAI for AI front desk
# OPENAI_API_KEY=

# Optional: Twilio SMS
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Optional: Google Business Profile OAuth
# GOOGLE_GBP_CLIENT_ID=
# GOOGLE_GBP_CLIENT_SECRET=

# Optional: public site canonical URL (defaults to NEXT_PUBLIC_APP_URL)
# NEXT_PUBLIC_SITE_URL=

# Optional: dedicated Supabase project for RLS integration tests (CI/staging)
# SUPABASE_TEST_URL=https://your-test-project.supabase.co
# SUPABASE_TEST_ANON_KEY=your-test-anon-key
# SUPABASE_TEST_SERVICE_ROLE_KEY=your-test-service-role-key

# Optional: logger verbosity (defaults to 'debug' in dev, 'info' in production)
# LOG_LEVEL=info
