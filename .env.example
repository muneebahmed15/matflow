# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role — server-only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe (required for billing)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# App URL used for Stripe checkout redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (optional in dev; required in production for transactional email)
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=MatsFlow <onboarding@yourdomain.com>

# Optional: dedicated Supabase project for RLS integration tests (CI/staging)
# SUPABASE_TEST_URL=https://your-test-project.supabase.co
# SUPABASE_TEST_ANON_KEY=your-test-anon-key
# SUPABASE_TEST_SERVICE_ROLE_KEY=your-test-service-role-key

# Optional (Phase 7+): Upstash Redis for distributed rate limiting in production
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
